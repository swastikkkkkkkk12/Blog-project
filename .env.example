# Local-only credentials for `docker compose up --build`.
# Replace these values before use. Never reuse them for a hosted database.
MYSQL_DATABASE=blogdb
MYSQL_USER=bloguser
MYSQL_PASSWORD=local-app-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
MYSQL_PORT=3306
APP_PORT=8080
APP_DEMO_READ_ONLY=false
